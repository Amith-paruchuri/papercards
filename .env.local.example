# PaperCards environment variables.
# Copy this file to .env.local and fill in values from the PaperCards Supabase project
# (Supabase dashboard > Project Settings > API). .env.local is gitignored.
# This must be PaperCards' own Supabase project, never Choti Copy's or BAALANCE's.

# Public: safe to expose to the browser (protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PAPERCARDS-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret: server-only. Never import in client components, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
